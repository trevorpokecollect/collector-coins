generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Shopify OAuth sessions (used by @shopify/shopify-app-session-storage-prisma)
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

// One row per Collector Coins member (a Shopify customer)
model Member {
  id                  String        @id @default(cuid())
  customerId          String        @unique // numeric Shopify customer id
  email               String?
  firstName           String?
  lastName            String?
  balance             Int           @default(0)
  lifetimeEarned      Int           @default(0) // drives the tier; tiers never drop
  tier                String        @default("poke")
  birthdayMonth       Int?
  birthdayDay         Int?
  birthdayYearAwarded Int?
  importedFromSmile   Boolean       @default(false)
  lastActivityAt      DateTime      @default(now()) // earning or redeeming; coins expire 12 months after this
  expiryWarnedAt      DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  transactions        Transaction[]
  rewards             Reward[]

  @@index([email])
  @@index([birthdayMonth, birthdayDay])
  @@index([lastActivityAt])
  @@index([tier])
}

// The coin ledger: every coin earned or spent is one row. balance = sum(amount).
model Transaction {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  amount      Int      // + earned, - spent or taken back
  kind        String   // purchase | refund | review | birthday | tier_bonus | redeem | redeem_undo | adjust | import
  description String
  orderId     String?
  earnRate    Int?     // coins per $1 used for a purchase, reused when a refund takes coins back
  countsToTier Boolean @default(true)
  idemKey     String?  @unique // stops a webhook delivered twice from paying twice
  meta        Json?    // purchase: coin promotion applied ({ promo, lineItemIds, promoCents, earnableCents, extraRate })
  staff       String?
  createdAt   DateTime @default(now())

  @@index([memberId, createdAt])
  @@index([orderId])
}

// Codes and gift cards a member holds
model Reward {
  id         String   @id @default(cuid())
  memberId   String
  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  kind       String   // order_discount | free_product | gift_card | tier_discount
  title      String
  coins      Int      @default(0)
  code       String?
  shopifyId  String?
  valueCents Int      @default(0)
  productId  String?
  idemKey    String?  @unique
  prevTier   String?  // for tier rewards: the tier the member was in before, so a refund can put them back
  revokedAt  DateTime? // tier reward cancelled because a refund took the tier back (code kept for staff)
  createdAt  DateTime @default(now())

  @@index([memberId, createdAt])
  @@index([createdAt])
}

// Storefront coin panel interactions (opens, tabs, earn and redeem clicks), for the Engagement page.
model PanelEvent {
  id        String   @id @default(cuid())
  event     String   // open | tab | click | submit
  target    String   // e.g. fab, launcher, link / earn, rewards / alerts, google, prize, join
  memberId  String?
  visitor   String?  // random id kept in the browser, to count unique visitors
  path      String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([event, target, createdAt])
  @@index([memberId, createdAt])
}

// App settings as JSON, one row per key (e.g. "panel" for the coin panel design).
model Setting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// Staff overrides for one prize product: a fixed coin cost and/or hiding it from the panel.
model PrizeOverride {
  productId String   @id // gid://shopify/Product/...
  coins     Int?
  hidden    Boolean  @default(false)
  note      String?
  updatedBy String?
  updatedAt DateTime @updatedAt
}
